extends layout

block content
  div(class="container mx-auto px-4 py-8")
    //- Page Header
    div(class="text-center mb-8")
      h1(class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-2") Anime Ongoing
      p(class="text-md text-gray-600 dark:text-gray-400") Daftar anime yang sedang tayang.

    if animeList && animeList.length > 0
      //- Anime Grid
      div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4 md:gap-6")
        each anime in animeList
          include includes/anime-card.pug

      //- Pagination
      if pagination && pagination.last_visible_page > 1
        nav(class="flex justify-center mt-10")
          div(class="flex items-center space-x-2")
            if pagination.current_page > 1
              a(href=`/ongoing?page=${pagination.current_page - 1}` class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-900 hover:text-primary-700 dark:hover:text-primary-300 transition-colors") Sebelumnya

            - const maxPages = 5
            - const startPage = Math.max(1, pagination.current_page - Math.floor(maxPages / 2))
            - const endPage = Math.min(pagination.last_visible_page, startPage + maxPages - 1)

            if startPage > 1
              a(href="/ongoing?page=1" class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-900 hover:text-primary-700 dark:hover:text-primary-300 transition-colors") 1
              if startPage > 2
                span(class="px-4 py-2") ...

            each page in Array.from({length: endPage - startPage + 1}, (_, i) => startPage + i)
              if page === pagination.current_page
                span(class="px-4 py-2 bg-primary-600 text-white rounded-lg font-medium")= page
              else
                a(href=`/ongoing?page=${page}` class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-900 hover:text-primary-700 dark:hover:text-primary-300 transition-colors")= page

            if endPage < pagination.last_visible_page
              if endPage < pagination.last_visible_page - 1
                span(class="px-4 py-2") ...
              a(href=`/ongoing?page=${pagination.last_visible_page}` class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-900 hover:text-primary-700 dark:hover:text-primary-300 transition-colors")= pagination.last_visible_page

            if pagination.has_next_page
              a(href=`/ongoing?page=${pagination.current_page + 1}` class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-900 hover:text-primary-700 dark:hover:text-primary-300 transition-colors") Selanjutnya

    else
      //- No Results
      div(class="text-center py-16")
        svg(class="w-20 h-20 text-gray-400 dark:text-gray-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z")
        h3(class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2") Belum Ada Anime Ongoing
        p(class="text-gray-600 dark:text-gray-400") Silakan cek kembali nanti.
