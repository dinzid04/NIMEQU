extends layout

block content
  div(class="container mx-auto px-4 py-8")
    //- Search Header
    div(class="text-center mb-8")
      h1(class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-2") Cari Komik
      p(class="text-md text-gray-600 dark:text-gray-400") Temukan komik favoritmu di sini.

    //- Search Form
    div(class="max-w-2xl mx-auto mb-10")
      form(action="/comic/search" method="GET" class="relative")
        input(
          type="text"
          name="q"
          placeholder="Ketik judul komik..."
          value=keyword || ""
          class="w-full px-6 py-4 text-lg border-2 border-gray-300 dark:border-gray-600 rounded-full bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-4 focus:ring-primary-300 dark:focus:ring-primary-700 focus:border-primary-500 dark:focus:border-primary-500 transition-all duration-300 shadow-sm"
          required
          autocomplete="off"
        )
        button(
          type="submit"
          class="absolute right-3 top-1/2 transform -translate-y-1/2 px-5 py-2 bg-primary-600 text-white rounded-full hover:bg-primary-700 transition-colors font-medium text-lg flex items-center"
        )
          svg(class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
          | Cari
