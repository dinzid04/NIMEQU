extends layout

block content
  div
    //- Banner
    div(class="relative h-48 md:h-64 bg-gray-300 dark:bg-gray-700")
      if anime.poster
        img(src=anime.poster alt=`${anime.title} Poster` class="w-full h-full object-cover object-center" onerror="this.onerror=null;this.src='/images/placeholder.png';")
      div(class="absolute inset-0 bg-gradient-to-t from-gray-50 dark:from-gray-900 to-transparent")

    div(class="container mx-auto px-4 -mt-24")
      div(class="flex flex-col md:flex-row md:space-x-8")
        //- Left Column (Poster)
        div(class="flex-shrink-0 w-48 md:w-56 mx-auto md:mx-0")
          img(src=anime.poster alt=anime.title class="w-full h-auto object-cover rounded-lg shadow-xl" onerror="this.onerror=null;this.src='/images/placeholder.png';")
          if anime.batch_links && anime.batch_links.length > 0
            a(href=`/anime/${anime.slug}/batch` class="block w-full mt-4 text-center bg-green-600 text-white px-4 py-3 rounded-lg hover:bg-green-700 transition-colors font-medium") Download Batch

        //- Right Column (Details)
        div(class="flex-1 mt-6 md:mt-24")
          //- Title and Actions
          div(class="flex flex-col sm:flex-row sm:items-start sm:justify-between")
            div
              h1(class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100")= anime.title
              div(class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-2")
                if anime.status
                  span(class="text-sm font-medium text-gray-600 dark:text-gray-300")= anime.status
                if anime.rating
                  div(class="flex items-center text-sm")
                    svg(class="w-4 h-4 text-yellow-400 mr-1" fill="currentColor" viewBox="0 0 20 20")
                      path(d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z")
                    span(class="ml-1 text-gray-600 dark:text-gray-300")= anime.rating
                if anime.release_year
                  span(class="text-sm text-gray-600 dark:text-gray-300")= anime.release_year

            //- Share Buttons
            div(class="flex space-x-2 mt-4 sm:mt-0")
              button(onclick=`shareToFacebook('${anime.title}')` class="p-2 bg-gray-200 dark:bg-gray-700 rounded-full hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors")
                svg(class="w-5 h-5 text-gray-600 dark:text-gray-300" fill="currentColor" viewBox="0 0 24 24")
                  path(d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v2.385z")
              button(onclick=`shareToTwitter('${anime.title}')` class="p-2 bg-gray-200 dark:bg-gray-700 rounded-full hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors")
                svg(class="w-5 h-5 text-gray-600 dark:text-gray-300" fill="currentColor" viewBox="0 0 24 24")
                  path(d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616v.064c0 3.188 2.274 5.85 5.29 6.456-.552.15-1.134.23-1.738.23-.424 0-.835-.04-1.234-.117.836 2.613 3.264 4.515 6.138 4.57-2.257 1.767-5.106 2.82-8.204 2.82-.534 0-1.06-.03-1.58-.093 2.92 1.876 6.39 2.97 10.06 2.97 12.07 0 18.67-10 18.67-18.67 0-.285-.007-.568-.02-.85.96-.692 1.79-1.56 2.45-2.54z")
              button(onclick="copyToClipboard()" class="p-2 bg-gray-200 dark:bg-gray-700 rounded-full hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors")
                svg(class="w-5 h-5 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m-8 4h.01M12 16h.01")

          //- Genres
          if anime.genres && anime.genres.length > 0
            div(class="mt-6")
              div(class="flex flex-wrap gap-2")
                each genre in anime.genres
                  a(href=`/genres/${genre.slug}` class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 text-sm rounded-full hover:bg-primary-100 dark:hover:bg-primary-900 hover:text-primary-700 dark:hover:text-primary-300 transition-colors")= genre.name

          //- Synopsis
          if anime.synopsis
            div(class="mt-6")
              h2(class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2") Sinopsis
              p(class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed whitespace-pre-line")= anime.synopsis

    //- Episode List
    div(class="container mx-auto px-4 mt-8")
      if anime.episodes && anime.episodes.length > 0
        div(class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6")
          div(class="flex justify-between items-center mb-4")
            h2(class="text-xl font-bold text-gray-900 dark:text-gray-100") Daftar Episode
            if anime.episodes.length > 24
              a(href=`/anime/${anime.slug}/episodes` class="text-primary-600 dark:text-primary-400 hover:underline text-sm font-medium") Lihat Semua

          div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3")
            each episode in anime.episodes.slice(0, 24)
              a(href=`/anime/${anime.slug}/episode/${episode.episode}` class="block p-3 text-center bg-gray-50 dark:bg-gray-700 rounded-md hover:bg-primary-100 dark:hover:bg-primary-900 hover:text-primary-700 dark:hover:text-primary-300 transition-colors")
                span(class="font-medium text-sm text-gray-800 dark:text-gray-200") Episode #{episode.episode}

      else
        div(class="text-center py-16")
          p(class="text-gray-600 dark:text-gray-400") Belum ada episode untuk anime ini.

block scripts
  script.
    function shareToFacebook(title) {
      const url = encodeURIComponent(window.location.href);
      const text = encodeURIComponent(`Nonton ${title} di ANIMAQU`);
      window.open(`https://www.facebook.com/sharer/sharer.php?u=${url}&quote=${text}`, '_blank', 'width=600,height=400');
    }

    function shareToTwitter(title) {
      const url = encodeURIComponent(window.location.href);
      const text = encodeURIComponent(`Nonton ${title} di ANIMAQU`);
      window.open(`https://twitter.com/intent/tweet?url=${url}&text=${text}`, '_blank', 'width=600,height=400');
    }

    function copyToClipboard() {
      navigator.clipboard.writeText(window.location.href).then(() => {
        alert('Link berhasil disalin!');
      }).catch(() => {
        alert('Gagal menyalin link.');
      });
    }
