extends layout

block content
  div(class="min-h-screen bg-gray-50 dark:bg-gray-900")
    div(class="container mx-auto px-4 py-6")
      div(class="grid grid-cols-1 lg:grid-cols-4 gap-8")
        div(class="lg:col-span-3 space-y-8")
          div(class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg overflow-hidden border border-gray-100 dark:border-gray-700")
            div(class="md:flex")
              div(class="md:flex-shrink-0")
                img(src=anime.poster alt=anime.title class="h-64 w-full object-cover md:h-full md:w-56")
              div(class="p-6 lg:p-8 flex-1 flex flex-col justify-between")
                div
                  h1(class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-3 leading-tight")= anime.title
                  div(class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-4 text-sm text-gray-600 dark:text-gray-400")
                    if anime.status
                      span(class="inline-flex items-center px-3 py-1 rounded-full font-medium bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-300")= anime.status
                    if anime.rating
                      div(class="flex items-center")
                        svg(class="w-4 h-4 text-yellow-400 mr-1.5" fill="currentColor" viewBox="0 0 20 20")
                          path(d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z")
                        span(class="font-semibold")= anime.rating
                    if anime.release_year
                      span= `Tahun: ${anime.release_year}`
                if anime.genres && anime.genres.length > 0
                  div(class="mb-5")
                    div(class="flex flex-wrap gap-2")
                      each genre in anime.genres
                        a(href=`/genres/${genre.slug}` class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-xs font-medium rounded-full hover:bg-primary-100 dark:hover:bg-primary-900 hover:text-primary-600 dark:hover:text-primary-300 transition-colors")= genre.name
                if anime.synopsis
                  div(class="mb-6")
                    p(class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed line-clamp-3")= anime.synopsis
                div(class="flex flex-wrap gap-3 mt-auto")
                  if anime.episodes && anime.episodes.length > 0
                    a(href=`/anime/${anime.slug}/episode/1` class="bg-primary-600 text-white px-5 py-3 rounded-lg hover:bg-primary-700 transition-all duration-300 transform hover:scale-105 font-semibold shadow-lg") Tonton Sekarang
                  if anime.batch_links && anime.batch_links.length > 0
                    a(href=`/anime/${anime.slug}/batch` class="bg-green-600 text-white px-5 py-3 rounded-lg hover:bg-green-700 transition-all duration-300 transform hover:scale-105 font-semibold shadow-lg") Download Batch

          if anime.episodes && anime.episodes.length > 0
            div(class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 lg:p-8 border border-gray-100 dark:border-gray-700")
              h2(class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6") Daftar Episode
              div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4")
                each episode in anime.episodes.slice(0, 24)
                  a(href=`/anime/${anime.slug}/episode/${episode.episode}` class="bg-gray-50 dark:bg-gray-700/50 hover:bg-primary-50 dark:hover:bg-primary-900/50 border border-gray-200 dark:border-gray-700 hover:border-primary-200 dark:hover:border-primary-600 rounded-xl p-4 text-center transition-all duration-300 transform hover:scale-105")
                    div(class="font-semibold text-gray-900 dark:text-gray-100") Episode #{episode.episode}
                    if episode.release_date
                      div(class="text-xs text-gray-500 dark:text-gray-400 mt-1")= episode.release_date
              if anime.episodes.length > 24
                div(class="mt-6 text-center")
                  a(href=`/anime/${anime.slug}/episodes` class="text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-medium") Lihat Semua Episode

        div(class="lg:col-span-1 space-y-8")
          div(class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700")
            h3(class="font-bold text-gray-900 dark:text-gray-100 mb-4 text-lg") Informasi Anime
            ul(class="space-y-3 text-sm")
              if anime.title
                li(class="flex justify-between")
                  span(class="font-semibold text-gray-700 dark:text-gray-300") Judul
                  span(class="text-gray-600 dark:text-gray-400 text-right")= anime.title
              if anime.status
                li(class="flex justify-between")
                  span(class="font-semibold text-gray-700 dark:text-gray-300") Status
                  span(class="text-gray-600 dark:text-gray-400")= anime.status
              if anime.release_year
                li(class="flex justify-between")
                  span(class="font-semibold text-gray-700 dark:text-gray-300") Tahun Rilis
                  span(class="text-gray-600 dark:text-gray-400")= anime.release_year
              if anime.rating
                li(class="flex justify-between")
                  span(class="font-semibold text-gray-700 dark:text-gray-300") Rating
                  span(class="text-gray-600 dark:text-gray-400")= anime.rating
              if anime.episodes && anime.episodes.length > 0
                li(class="flex justify-between")
                  span(class="font-semibold text-gray-700 dark:text-gray-300") Total Episode
                  span(class="text-gray-600 dark:text-gray-400")= anime.episodes.length

          div(class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700")
            h3(class="font-bold text-gray-900 dark:text-gray-100 mb-4 text-lg") Bagikan
            div(class="space-y-3")
              button(onclick=`shareToFacebook('${anime.title}')` class="w-full bg-blue-600 text-white py-3 px-4 rounded-lg text-sm font-medium hover:bg-blue-700 transition-colors transform hover:scale-105") Facebook
              button(onclick=`shareToTwitter('${anime.title}')` class="w-full bg-sky-500 text-white py-3 px-4 rounded-lg text-sm font-medium hover:bg-sky-600 transition-colors transform hover:scale-105") Twitter
              button(onclick="copyToClipboard()" class="w-full bg-gray-600 text-white py-3 px-4 rounded-lg text-sm font-medium hover:bg-gray-700 transition-colors transform hover:scale-105") Copy Link

          div(class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700")
            h3(class="font-bold text-gray-900 dark:text-gray-100 mb-4 text-lg") Anime Serupa
            div(class="text-sm text-gray-500 dark:text-gray-400 text-center py-8") Fitur ini akan segera hadir.


block scripts
  script.
    function shareToFacebook(title) {
      const url = encodeURIComponent(window.location.href);
      const text = encodeURIComponent(`Nonton ${title} di ANIMAQU`);
      window.open(`https://www.facebook.com/sharer/sharer.php?u=${url}&quote=${text}`, '_blank', 'width=600,height=400');
    }

    function shareToTwitter(title) {
      const url = encodeURIComponent(window.location.href);
      const text = encodeURIComponent(`Nonton ${title} di ANIMAQU`);
      window.open(`https://twitter.com/intent/tweet?url=${url}&text=${text}`, '_blank', 'width=600,height=400');
    }

    function copyToClipboard() {
      navigator.clipboard.writeText(window.location.href).then(() => {
        alert('Link berhasil disalin!');
      }).catch(() => {
        const textArea = document.createElement('textarea');
        textArea.value = window.location.href;
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand('copy');
        document.body.removeChild(textArea);
        alert('Link berhasil disalin!');
      });
    }

    if ('IntersectionObserver' in window) {
      const imageObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const img = entry.target;
            if (img.dataset.src) {
              img.src = img.dataset.src;
              img.classList.remove('lazy');
              imageObserver.unobserve(img);
            }
          }
        });
      });

      document.querySelectorAll('img[data-src]').forEach(img => {
        imageObserver.observe(img);
      });
    }
