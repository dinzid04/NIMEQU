extends layout

block content
  div(class="container mx-auto px-4 py-8")
    //- Page Header
    div(class="text-center mb-8")
      h1(class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-2") Genre Anime
      p(class="text-md text-gray-600 dark:text-gray-400") Jelajahi anime berdasarkan genre favorit Anda.

    if genres && genres.length > 0
      //- Genre Grid
      div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4 md:gap-5")
        each genre in genres
          a(href=`/genres/${genre.slug}` class="group block text-center p-4 bg-white dark:bg-gray-800 rounded-lg shadow-sm hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300 border border-gray-200 dark:border-gray-700")
            h3(class="font-semibold text-gray-800 dark:text-gray-200 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors")= genre.name
            if genre.count
              p(class="text-xs text-gray-500 dark:text-gray-400 mt-1")= `${genre.count} anime`

    else
      //- No Genres
      div(class="text-center py-16")
        p(class="text-gray-600 dark:text-gray-400") Genre tidak tersedia saat ini.
