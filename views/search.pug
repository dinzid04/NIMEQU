extends layout

block content
  div(class="container mx-auto px-4 py-8")
    //- Search Header
    div(class="text-center mb-8")
      h1(class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-2") Cari Anime
      p(class="text-md text-gray-600 dark:text-gray-400") Temukan anime favoritmu di sini.

    //- Search Form
    div(class="max-w-2xl mx-auto mb-10")
      form(action="/search" method="GET" class="relative")
        input(
          type="text"
          name="q"
          placeholder="Ketik judul anime..."
          value=keyword || ""
          class="w-full px-6 py-4 text-lg border-2 border-gray-300 dark:border-gray-600 rounded-full bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-4 focus:ring-primary-300 dark:focus:ring-primary-700 focus:border-primary-500 dark:focus:border-primary-500 transition-all duration-300 shadow-sm"
          required
          autocomplete="off"
        )
        button(
          type="submit"
          class="absolute right-3 top-1/2 transform -translate-y-1/2 px-5 py-2 bg-primary-600 text-white rounded-full hover:bg-primary-700 transition-colors font-medium text-lg flex items-center"
        )
          svg(class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
          | Cari

    if keyword && searchResults
      if searchResults.length > 0
        //- Search Results
        div(class="mb-6")
          p(class="text-gray-600 dark:text-gray-400 text-center") Menampilkan
            strong #{searchResults.length} hasil
            |  untuk
            strong "#{keyword}"

        div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4 md:gap-6")
          each anime in searchResults
            include includes/anime-card.pug

      else
        //- No Results
        div(class="text-center py-16")
          svg(class="w-20 h-20 text-gray-400 dark:text-gray-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z")
          h3(class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2") Yah, tidak ada hasil...
          p(class="text-gray-600 dark:text-gray-400") Coba gunakan kata kunci yang lain.

    else if !keyword
      //- Popular Searches
      div(class="text-center py-12")
        h3(class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-6") Pencarian Populer
        div(class="flex flex-wrap gap-3 justify-center max-w-3xl mx-auto")
          each term in ['Naruto', 'One Piece', 'Attack on Titan', 'Demon Slayer', 'Jujutsu Kaisen', 'My Hero Academia', 'Solo Leveling', 'Kimetsu no Yaiba']
            a(href=`/search?q=${encodeURIComponent(term)}` class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 text-sm rounded-full hover:bg-primary-100 dark:hover:bg-primary-900 hover:text-primary-700 dark:hover:text-primary-300 transition-all duration-200 transform hover:scale-105")= term
