extends layout

block content
  div(class="container mx-auto px-4 py-6")
    div(class="grid grid-cols-1 lg:grid-cols-4 gap-8")
      div(class="lg:col-span-3")
        div(class="mb-8")
          h1(class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-2")
            if keyword
              | Hasil Pencarian untuk "#{keyword}"
            else
              | Temukan Anime Favoritmu
          p(class="text-gray-600 dark:text-gray-400") Cari dari ribuan anime dengan subtitle Indonesia.
          
          form(action="/search" method="GET" class="mt-6")
            div(class="relative")
              input(
                type="text"
                name="q"
                placeholder="Contoh: Naruto, One Piece..."
                value=keyword || ""
                class="w-full px-5 py-4 pl-12 border border-gray-300 dark:border-gray-700 rounded-full bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-200 focus:ring-4 focus:ring-primary-300 dark:focus:ring-primary-800 focus:border-transparent transition-shadow duration-300 shadow-sm hover:shadow-md"
                required
              )
              div(class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400 dark:text-gray-500")
                svg(class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
              button(
                type="submit"
                class="absolute right-2 top-1/2 transform -translate-y-1/2 px-6 py-2 bg-primary-600 text-white rounded-full hover:bg-primary-700 focus:outline-none focus:ring-4 focus:ring-primary-300 dark:focus:ring-primary-800 transition-all duration-300 transform hover:scale-105"
              ) Cari

        if keyword && searchResults
          if searchResults.length > 0
            div(class="mb-6 pb-4 border-b border-gray-200 dark:border-gray-700")
              p(class="text-gray-700 dark:text-gray-300") Menampilkan
                strong= searchResults.length
                | hasil untuk "
                strong= keyword
                | ".
            
            div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-x-4 gap-y-6 mb-8")
              each anime in searchResults
                div(class="anime-card group relative")
                  a(href=`/anime/${anime.slug}`)
                    div(class="relative bg-white/90 dark:bg-gray-800/90 rounded-2xl shadow-lg hover:shadow-2xl dark:shadow-gray-900/50 overflow-hidden transform transition-all duration-300 hover:scale-105 border border-gray-100 dark:border-gray-700 backdrop-blur-sm")
                      div(class="relative overflow-hidden")
                        img(src=anime.poster alt=anime.title class="w-full h-64 object-cover transition-transform duration-500 group-hover:scale-110")
                        div(class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300")
                        if anime.status
                          div(class="absolute top-3 left-3 bg-gradient-to-r from-primary-500 to-primary-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg backdrop-blur-sm")= anime.status
                        if anime.rating
                          div(class="absolute top-3 right-3 bg-black/70 backdrop-blur-sm text-white text-xs px-2 py-1 rounded-full flex items-center")
                            svg(class="w-3 h-3 mr-1 text-yellow-400" fill="currentColor" viewBox="0 0 20 20")
                              path(d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z")
                            span= anime.rating
                      div(class="p-4")
                        h3(class="font-bold text-sm text-gray-900 dark:text-gray-100 line-clamp-2 mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors duration-200")= anime.title

          else
            div(class="text-center py-16 px-6 bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700")
              svg(class="w-16 h-16 text-primary-400 dark:text-primary-600 mx-auto mb-6 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z")
              h2(class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2") Yah, Tidak Ditemukan...
              p(class="text-gray-600 dark:text-gray-400 max-w-md mx-auto") Kami tidak dapat menemukan anime dengan kata kunci "#{keyword}". Coba gunakan kata kunci lain.

        else if !keyword
          div(class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-8 border border-gray-100 dark:border-gray-700")
            h3(class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-4") Trending Searches
            div(class="flex flex-wrap gap-3")
              each term in ['Naruto', 'One Piece', 'Attack on Titan', 'Demon Slayer', 'Jujutsu Kaisen', 'My Hero Academia']
                a(href=`/search?q=${encodeURIComponent(term)}` class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 text-sm font-medium rounded-full hover:bg-primary-100 dark:hover:bg-primary-900 hover:text-primary-700 dark:hover:text-primary-300 transition-all duration-300 transform hover:scale-105")= term

      div(class="lg:col-span-1 space-y-8")
        div(class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700")
          h3(class="font-bold text-gray-900 dark:text-gray-100 mb-4 text-lg flex items-center")
            svg(class="w-5 h-5 mr-3 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z")
            | Tips Pencarian
          ul(class="space-y-3 text-sm text-gray-600 dark:text-gray-400 list-disc list-inside")
            li Gunakan kata kunci yang spesifik.
            li Coba judul bahasa Inggris atau Jepang.
            li Gunakan kata kunci umum jika buntu.

        div(class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border border-gray-100 dark:border-gray-700")
          h3(class="font-bold text-gray-900 dark:text-gray-100 mb-4 text-lg") Genre Populer
          div(class="flex flex-wrap gap-2")
            each genre in genres
              a(href=`/genres/${genre.slug}` class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-xs font-medium rounded-full hover:bg-primary-100 dark:hover:bg-primary-900 hover:text-primary-600 dark:hover:text-primary-400 transition-colors")= genre.name
